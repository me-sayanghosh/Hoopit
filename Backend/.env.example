MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<db>

# Backend public base URL used for generated short links
APP_URL=https://hoopit.onrender.com

# Frontend origin used for CORS. Do not add a trailing slash.
FRONTEND_URL=https://hoopit.vercel.app

JWT_SECRET=replace_with_a_strong_secret
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GEMINI_API_KEY=

MAIL_FROM="Hoopit <no-reply@example.com>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
